# Copy to .env and adjust as needed for local development.

# --- Database ---
POSTGRES_USER=tasknotes
POSTGRES_PASSWORD=tasknotes
POSTGRES_DB=tasknotes
# Full connection string used by the backend (Docker Compose service name "db"
# when running via `docker compose up`; use "localhost" when running the
# backend directly on the host; the host port is 5442, remapped from the
# container's 5432 to avoid a clash with another local Postgres).
DATABASE_URL=postgresql://tasknotes:tasknotes@localhost:5442/tasknotes

# --- Frontend ---
# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8010

# --- Build ---
# Optional. Commit sha baked into the backend image at build time; GET
# /api/version reports its first 12 characters. Set by CI or the image build,
# defaults to "unknown" when unset.
# BUILD_COMMIT=
