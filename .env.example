# Copy to .env and adjust as needed for local development.

# --- Database ---
POSTGRES_USER=tasknotes
POSTGRES_PASSWORD=tasknotes
POSTGRES_DB=tasknotes
# Full connection string used by the backend (Docker Compose service name "db"
# when running via `docker compose up`; use "localhost" when running the
# backend directly on the host).
DATABASE_URL=postgresql://tasknotes:tasknotes@localhost:5432/tasknotes

# --- Frontend ---
# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000

# --- Backend CORS ---
# Origin the backend allows via CORS (must match where the frontend is served
# from; the browser calls the API on a different port than the dev server).
FRONTEND_ORIGIN=http://localhost:5173
