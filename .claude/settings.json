{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "mayker": {
      "source": {
        "source": "github",
        "repo": "bemayker/mayker-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "mayker-dev@mayker": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(paste:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(realpath:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)",
      "Bash(readlink:*)",
      "Bash(test:*)",
      "Bash(true)",
      "Bash(false)",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(date:*)",
      "Bash(sleep:*)",
      "Bash(jq:*)",
      "Bash(env)",
      "Bash(which:*)",
      "Bash(command:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(prettier:*)",
      "Bash(eslint:*)",
      "Bash(playwright:*)",
      "Bash(vitest:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Skill",
      "Agent",
      "Task",
      "ToolSearch",
      "TodoWrite",
      "TaskCreate",
      "mcp__clickup__*",
      "mcp__github__*",
      "mcp__claude_ai_composio__COMPOSIO_SEARCH_TOOLS",
      "mcp__claude_ai_composio__COMPOSIO_MULTI_EXECUTE_TOOL",
      "mcp__claude_ai_composio__COMPOSIO_REMOTE_BASH_TOOL"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(claude plugin:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.git/**)"
    ]
  }
}
